{
  "name": "@robertdevore/paperclip-goal-issues",
  "version": "0.1.0",
  "type": "module",
  "description": "Track issues related to Paperclip goals without changing Paperclip core.",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "build:rollup": "rollup -c",
    "dev": "node ./esbuild.config.mjs --watch",
    "dev:ui": "paperclip-plugin-dev-server --root . --ui-dir dist/ui --port 4177",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "CORE_REQUIREMENTS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertdevore/paperclip-goal-issues.git"
  },
  "homepage": "https://github.com/robertdevore/paperclip-goal-issues#readme",
  "bugs": {
    "url": "https://github.com/robertdevore/paperclip-goal-issues/issues"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "ui"
  ],
  "author": "Robert DeVore",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.722.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "esbuild": "^0.28.1",
    "rollup": "^4.38.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
